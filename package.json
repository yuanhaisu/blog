    "test:e2e": "playwright test",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "check:secrets": "node scripts/check-no-secrets.mjs"
  },
  "dependencies": {
    "@nuxt/content": "~3.16.2",
    "better-sqlite3": "^13.0.3",
