# 统计站点标识（不是密钥，会出现在公开页面的脚本配置中）。
# 未设置时构建使用 app/utils/analytics.ts 中的占位值。
# Cloudflare Web Analytics：Cloudflare Dashboard → Web Analytics 的 Beacon token。
NUXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
# 百度统计：管理后台站点代码 hm.js? 后面的站点 ID。
NUXT_PUBLIC_BAIDU_ANALYTICS_ID=

# Giscus 评论配置（不是密钥，会出现在公开 HTML 与 giscus.app 的 iframe 参数中）。
# 在 https://giscus.app/zh-CN 按仓库生成配置，或从仓库 Discussions 设置读取。
# repo 默认 yuanhaisu/blog；category 需为 Announcements 类型。
# 未设置时构建使用 app/utils/giscus.ts 中的占位值，评论无法真正工作。
NUXT_PUBLIC_GISCUS_REPO=
NUXT_PUBLIC_GISCUS_REPO_ID=
NUXT_PUBLIC_GISCUS_CATEGORY=
NUXT_PUBLIC_GISCUS_CATEGORY_ID=

# 已确认的国内平台主页（不是密钥）。
# 只有确认真实 URL 后才填写；留空时关于页与评论区显示“账号准备中”占位，
# 同时不会写入 Person.sameAs，避免出现编造或失效的账号链接。
NUXT_PUBLIC_ZHIHU_URL=
NUXT_PUBLIC_WECHAT_MP_URL=
